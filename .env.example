# ==============================================================================
# BUILDTRACK ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. DATABASE CONFIGURATION (NEON POSTGRESQL)
# Neon Pooled Connection URL (for Next.js application queries):
DATABASE_URL="postgresql://user:password@ep-pooler.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Neon Direct Connection URL (for Prisma migrations / schema push):
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-direct.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Neon Branch Telemetry
NEON_BRANCH="production"
NEON_BRANCH_ID="br-sample-branch-id"
NEON_FUNCTION_HOST_SUFFIX=".compute.c-9.us-east-2.aws.neon.tech"

# 2. S3-COMPATIBLE OBJECT STORAGE (NEON STORAGE)
# Issue/pull credentials using: `neon deploy` or `neon credentials create`
AWS_ENDPOINT_URL_S3="https://<branch-id>.storage.c-9.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_sample_access_key"
AWS_SECRET_ACCESS_KEY="nsk_live_sample_secret_key"
AWS_REGION="us-east-2"

# 3. NEXTAUTH / AUTH.JS CREDENTIALS
# Generate a secure 32+ character key using: `openssl rand -base64 32`
AUTH_SECRET="buildtrack-forged-steel-molten-amber-jwt-secret-key-32-chars-min!"
NEXTAUTH_SECRET="buildtrack-forged-steel-molten-amber-jwt-secret-key-32-chars-min!"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# 4. APPLICATION RUNTIME
NODE_ENV="production"
PORT=3000
