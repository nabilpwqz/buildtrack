generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Company {
  id        String    @id @default(cuid())
  name      String
  address   String?
  email     String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  projects  Project[]
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String
  name                 String
  role                 String                @default("SITE_ENGINEER") // ADMIN, PROJECT_MANAGER, SITE_ENGINEER, FINANCE_MANAGER, CONTRACTOR
  status               String                @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  companyId            String?
  company              Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contractorId         String?
  contractor           Contractor?           @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  avatarUrl            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  managedProjects      Project[]             @relation("ProjectManager")
  projectMemberships   ProjectMember[]
  assignedTasks        Task[]                @relation("TaskAssignee")
  recordedExpenses     Expense[]             @relation("ExpenseRecorder")
  materialRequests     MaterialRequest[]     @relation("MaterialRequester")
  materialTransactions MaterialTransaction[] @relation("TransactionUser")
  progressReports      ProgressReport[]      @relation("ProgressReporter")
  siteReports          SiteReport[]          @relation("SiteReporter")
  delayReports         DelayReport[]         @relation("DelayReporter")
  taskComments         TaskComment[]
  taskHistories        TaskHistory[]
  notifications        Notification[]
  documents            Document[]

  @@index([email])
  @@index([role])
}

model Project {
  id                   String                @id @default(cuid())
  name                 String
  description          String?
  location             String
  startDate            DateTime
  expectedEndDate      DateTime
  actualEndDate        DateTime?
  totalBudget          Float                 @default(0)
  status               String                @default("PLANNING") // PLANNING, IN_PROGRESS, DELAYED, ON_HOLD, COMPLETED
  progress             Float                 @default(0) // Rollup progress 0-100
  managerId            String?
  manager              User?                 @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  companyId            String?
  company              Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  members              ProjectMember[]
  contractors          ProjectContractor[]
  milestones           Milestone[]
  tasks                Task[]
  expenses             Expense[]
  budgets              Budget[]
  materialRequests     MaterialRequest[]
  materialTransactions MaterialTransaction[]
  progressReports      ProgressReport[]
  siteReports          SiteReport[]
  delayReports         DelayReport[]
  documents            Document[]

  @@index([managerId])
  @@index([status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Contractor {
  id                 String                  @id @default(cuid())
  name               String
  company            String
  contact            String
  email              String                  @unique
  phone              String
  specialty          String
  status             String                  @default("ACTIVE") // ACTIVE, SUSPENDED
  rating             Float                   @default(5.0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  users              User[]
  projectAssignments ProjectContractor[]
  performances       ContractorPerformance[]

  @@index([status])
}

model ProjectContractor {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  role         String
  assignedAt   DateTime   @default(now())

  @@unique([projectId, contractorId])
  @@index([projectId])
  @@index([contractorId])
}

model ContractorPerformance {
  id             String     @id @default(cuid())
  contractorId   String
  contractor     Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  projectId      String
  onTimeRate     Float      @default(100) // 0-100
  qualityScore   Float      @default(5.0) // 1-5
  delayIncidents Int        @default(0)
  notes          String?
  evaluatedAt    DateTime   @default(now())

  @@index([contractorId])
  @@index([projectId])
}

model Milestone {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  targetDate    DateTime
  completedDate DateTime?
  status        String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
  @@index([status])
}

model Task {
  id                   String                @id @default(cuid())
  projectId            String
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  description          String?
  assigneeId           String?
  assignee             User?                 @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority             String                @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  deadline             DateTime
  status               String                @default("TODO") // TODO, IN_PROGRESS, REVIEW, COMPLETED
  progress             Float                 @default(0) // 0-100
  estimatedHours       Float                 @default(8)
  actualHours          Float                 @default(0)
  completedAt          DateTime?
  isDeleted            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  dependencies         TaskDependency[]      @relation("DependentTask")
  dependedOnBy         TaskDependency[]      @relation("PrerequisiteTask")
  comments             TaskComment[]
  history              TaskHistory[]
  progressReports      ProgressReport[]
  materialTransactions MaterialTransaction[]
  delayReports         DelayReport[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([deadline])
  @@index([isDeleted])
}

model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId String
  dependsOn   Task     @relation("PrerequisiteTask", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([taskId, dependsOnId])
  @@index([taskId])
  @@index([dependsOnId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
}

model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // STATUS_CHANGE, PROGRESS_UPDATE, ASSIGNED, DETAILS_UPDATED
  from      String?
  to        String?
  details   String?
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId])
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenses    Expense[]
  budgets     Budget[]
}

model Budget {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  allocated   Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([projectId, categoryId])
  @@index([projectId])
  @@index([categoryId])
}

model Expense {
  id           String          @id @default(cuid())
  title        String
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId   String
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount       Float
  date         DateTime
  description  String?
  recordedById String
  recordedBy   User            @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: Cascade)
  documentUrl  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([projectId])
  @@index([categoryId])
  @@index([recordedById])
  @@index([date])
}

model MaterialCategory {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  materials   Material[]
}

model Material {
  id           String                @id @default(cuid())
  name         String
  sku          String                @unique
  unit         String                // Bags, Tons, Units, Meters, Liters, etc.
  categoryId   String
  category     MaterialCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  availableQty Float                 @default(0)
  reorderLevel Float                 @default(10)
  unitCost     Float                 @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  requests     MaterialRequest[]
  transactions MaterialTransaction[]

  @@index([categoryId])
  @@index([sku])
}

model MaterialRequest {
  id          String    @id @default(cuid())
  materialId  String
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User      @relation("MaterialRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  qty         Float
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, FULFILLED
  reason      String?
  approvedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([materialId])
  @@index([projectId])
  @@index([requesterId])
  @@index([status])
}

model MaterialTransaction {
  id           String   @id @default(cuid())
  type         String   // RECEIVE, ISSUE, CONSUME, ADJUST
  qty          Float
  balanceAfter Float
  materialId   String
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  userId       String
  user         User     @relation("TransactionUser", fields: [userId], references: [id], onDelete: Cascade)
  notes        String?
  createdAt    DateTime @default(now())

  @@index([materialId])
  @@index([projectId])
  @@index([taskId])
  @@index([type])
}

model ProgressReport {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  percentage   Float
  description  String
  photos       String   @default("[]") // JSON string array of URLs
  reportedById String
  reportedBy   User     @relation("ProgressReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([taskId])
  @@index([reportedById])
}

model SiteReport {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedById    String
  reportedBy      User     @relation("SiteReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  weather         String
  workersCount    Int      @default(0)
  equipmentOnSite String?
  workCompleted   String
  issuesFaced     String?
  safetyIncidents Int      @default(0)
  photos          String   @default("[]") // JSON string array
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([reportedById])
  @@index([date])
}

model DelayReport {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reason         String
  impactDays     Int      @default(1)
  mitigationPlan String
  status         String   @default("OPEN") // OPEN, MITIGATED, RESOLVED
  reportedById   String
  reportedBy     User     @relation("DelayReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
  @@index([taskId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // TASK_ASSIGNED, OVERDUE, BUDGET_OVERRUN, LOW_STOCK, REQUEST_APPROVED, REPORT_SUBMITTED, SYSTEM
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  actorRole String
  action    String   // CREATE, UPDATE, DELETE, TRANSITION, APPROVE, ISSUE
  entity    String   // Project, Task, Expense, Material, Contractor, etc.
  entityId  String
  meta      String?  // JSON string for details
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

model Document {
  id           String   @id @default(cuid())
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String
  fileUrl      String
  fileType     String
  fileSize     Int      @default(0)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([projectId])
  @@index([uploadedById])
}

